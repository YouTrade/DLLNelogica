# ---------------------------------------------------------------------------
# Saída de compilação .NET
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
publish/
*.publishsettings

# ---------------------------------------------------------------------------
# IDEs e editores
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates

# ---------------------------------------------------------------------------
# Relatórios e logs
# A aplicação grava em "Relatorios/AAAAMMDD/"; a ProfitDLL grava em "logs/".
# Nenhum dos dois deve ser versionado: contêm dados operacionais, e os arquivos
# por instrumento chegam facilmente a centenas de MB por pregão.
# ---------------------------------------------------------------------------
Relatorios/
log/
logs/
*.log

# ---------------------------------------------------------------------------
# Artefatos gerados pela ProfitDLL ao lado do executável
# ---------------------------------------------------------------------------
MarketHours2/
PopupManagerV2/
database/
roteamento/
ServerAddr*.dat
InfoSSLServerAddr*.dat
HadesSSLServerAddr*.dat
ReplayServerAddr*.dat
ProfitChart.dat
holidays.dat
timezone2.dat
newagents.dat
*.profrun

# ---------------------------------------------------------------------------
# NuGet
# ---------------------------------------------------------------------------
packages/
.nuget/
*.nupkg
*.snupkg

# ---------------------------------------------------------------------------
# Testes e cobertura
# ---------------------------------------------------------------------------
TestResults/
*.trx
*.coverage
coverage*.xml

# ---------------------------------------------------------------------------
# Credenciais e chaves — nunca versionar
# O src/appsettings.json versionado é o modelo, com os campos vazios.
# ---------------------------------------------------------------------------
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
appsettings.*.local.json
secrets.json
*.pfx
*.snk

# ---------------------------------------------------------------------------
# Utilitários locais de desenvolvimento
# Ferramentas de apoio do mantenedor não fazem parte do material didático.
# ---------------------------------------------------------------------------
tools/

# ---------------------------------------------------------------------------
# Sistema operacional
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------------------------------------------------------------------------
# Estado de sessão de ferramentas de assistência
# Artefatos locais do agente; não fazem parte do material publicado.
# ---------------------------------------------------------------------------
.claudecodex/

# ---------------------------------------------------------------------------
# Material não publicado
# Decisão do mantenedor: a documentação de trabalho fica local. O código de
# src/ e o projeto de testes em tests/ continuam publicados, mantendo o
# DLLNelogica.sln coerente para quem clonar o repositório.
# ---------------------------------------------------------------------------
docs/
